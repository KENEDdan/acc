# Copy this to .env and fill in real values. Never commit .env itself.

# --- Core ---
DEBUG=False
# Set to config.settings.dev for local development, config.settings.prod to deploy.
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
ALLOWED_HOSTS=apostoliccampuschurch.org,www.apostoliccampuschurch.org

# --- Database (PostgreSQL) ---
DB_NAME=acc_platform
DB_USER=acc_admin
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Celery broker/result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Email (password resets). Omit to fall back to the console backend. ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@apostoliccampuschurch.org

# --- Production-only hardening (config/settings/prod.py) ---
# Start SECURE_SSL_REDIRECT=False only if you're not behind HTTPS yet.
SECURE_SSL_REDIRECT=True
# Start low (the default, one day) and only raise once HTTPS is confirmed
# solid — HSTS is easy to lock yourself out of on a botched cert renewal.
SECURE_HSTS_SECONDS=86400
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
