# Rendered to /etc/nginx/conf.d/app.conf at container startup by the nginx
# image's built-in envsubst step (see NGINX_ENVSUBST_FILTER in
# docker-compose.prod.yml) — only ${DOMAIN} is substituted, every other $var
# below is a real nginx variable, left as-is.

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/nginx/certs/cloudflare-origin.pem;
    ssl_certificate_key /etc/nginx/certs/cloudflare-origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Matches the largest upload accepted by the app (library resources, see
    # church.models.validate_library_file_size), plus a little headroom.
    client_max_body_size 30M;

    # Docker's embedded DNS (always 127.0.0.11 on a compose-created network).
    # nginx resolves a bare `proxy_pass http://web:8000` ONCE, at startup, and
    # caches that IP forever — so a redeploy that recreates the web container
    # (new IP) leaves nginx silently proxying to whatever container now holds
    # the OLD IP until nginx itself is restarted (a 502, or worse, a request
    # reaching the wrong service). Routing proxy_pass through a variable
    # forces nginx to re-resolve `web` via this resolver on this TTL instead.
    resolver 127.0.0.11 valid=10s;
    set $web_upstream http://web:8000;

    location / {
        proxy_pass $web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
